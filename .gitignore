# ==========================================
# Git Ignore Configuration for Python/C++/CUDA Custom Extension
# ==========================================

# 1. Compiled Shared Libraries and Object Files
*.so
*.o
*.obj
*.dll
*.dylib
modules/*.o
build/
dist/
vulnerability_benchmark_ops.egg-info/

# 2. Python Caching and Virtual Environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.ipynb_checkpoints/

# 3. Dynamic Generated Files during setup
setup.py

# 4. OS and System Files
.DS_Store
Thumbs.db

# 5. IDE and Local Project Configuration Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
